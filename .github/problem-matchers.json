{
  "problemMatcher": [
    {
      "owner": "kotlin",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^e: (?:file://)?(.+\\.kt):(\\d+):(\\d+)\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      ]
    },
    {
      "owner": "javac",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(.+\\.java):(\\d+): error: (.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        }
      ]
    }
  ]
}
